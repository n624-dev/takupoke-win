<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <ProjectReference Include="../Takupoke.Core/Takupoke.Core.csproj" />
    <ProjectReference Include="../Takupoke.Infrastructure/Takupoke.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../packaging/legal/*.txt" Link="Legal/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The unpackaged publish pipeline does not automatically carry the XAML
       compiler's loose binary resources from the build output into deployment. -->
  <Target Name="PublishCompiledWinUiResources" AfterTargets="Publish" Condition="'$(WindowsPackageType)' == 'None'">
    <ItemGroup>
      <_CompiledWinUiResource Include="$(TargetDir)**/*.xbf" Exclude="$(TargetDir)publish/**;$(PublishDir)**" />
      <_CompiledWinUiResource Include="$(TargetDir)$(TargetName).pri" Condition="Exists('$(TargetDir)$(TargetName).pri')" />
      <_CompiledWinUiResource Include="$(TargetDir)resources.pri" Condition="Exists('$(TargetDir)resources.pri')" />
    </ItemGroup>
    <Copy SourceFiles="@(_CompiledWinUiResource)" DestinationFiles="@(_CompiledWinUiResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
