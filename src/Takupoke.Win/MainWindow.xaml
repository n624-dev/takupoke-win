<Window
    x:Class="Takupoke.Win.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="たくポケ">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" AutomationProperties.AutomationId="app-titlebar">
            <Image Source="ms-appx:///Assets/takupoke.png" Width="24" Height="24" Margin="18,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
        </Grid>
        <NavigationView Grid.Row="1" x:Name="Navigation" AutomationProperties.AutomationId="main-navigation" IsBackButtonVisible="Collapsed" PaneDisplayMode="Auto" IsSettingsVisible="False"
                        SelectionChanged="Navigation_SelectionChanged" ItemInvoked="Navigation_ItemInvoked" OpenPaneLength="216" Background="Transparent">
            <NavigationView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#2563EB" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#2563EB" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="ホーム" Tag="home" AutomationProperties.AutomationId="nav-home" />
                <NavigationViewItem Content="一覧" Tag="links" AutomationProperties.AutomationId="nav-links" />
                <NavigationViewItem Content="時間割" Tag="timetable" AutomationProperties.AutomationId="nav-timetable" />
                <NavigationViewItem Content="設定" Tag="settings" AutomationProperties.AutomationId="nav-settings" />
            </NavigationView.MenuItems>
            <ScrollViewer x:Name="PageScroller" AutomationProperties.AutomationId="page-scroller" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="PageContent" Padding="32,24,32,32" Spacing="24" MaxWidth="960" />
                </ContentControl>
            </ScrollViewer>
        </NavigationView>
        <Grid x:Name="StatusBar" Grid.Row="2" Padding="24,12" ColumnSpacing="12" Visibility="Collapsed" AutomationProperties.AutomationId="status-bar">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <ProgressBar x:Name="Activity" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.AutomationId="operation-progress" />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="operation-status" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="CancelButton" Content="処理を中止" Click="Cancel_Click" Visibility="Collapsed" AutomationProperties.AutomationId="cancel-operation" />
                <Button x:Name="DismissStatusButton" Content="閉じる" Click="DismissStatus_Click" Visibility="Collapsed" AutomationProperties.Name="結果を閉じる" AutomationProperties.AutomationId="dismiss-status" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
