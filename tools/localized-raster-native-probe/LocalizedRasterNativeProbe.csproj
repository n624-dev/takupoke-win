<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0-windows10.0.26100.0</TargetFramework><RuntimeIdentifier>win-x64</RuntimeIdentifier><EnableWindowsTargeting>true</EnableWindowsTargeting><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><WindowsPackageType>None</WindowsPackageType><WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><AppxGeneratePriEnabled>false</AppxGeneratePriEnabled><AppxGeneratePrisForPortableLibrariesEnabled>false</AppxGeneratePrisForPortableLibrariesEnabled><TakupokeRepositoryRoot Condition="'$(TakupokeRepositoryRoot)' == ''">$(MSBuildThisFileDirectory)../../</TakupokeRepositoryRoot></PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1"/><PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169"/><PackageReference Include="Microsoft.AI.Foundry.Local.WinML" Version="1.2.4"/><PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0"/></ItemGroup>
  <ItemGroup>
    <Compile Remove="preflight/**/*.cs" />
    <ProjectReference Include="$(TakupokeRepositoryRoot)/src/Takupoke.Infrastructure/Takupoke.Infrastructure.csproj"/>
    <Compile Include="$(TakupokeRepositoryRoot)/src/Takupoke.Win/Platform/WindowsRecoveryModels.cs" Link="WindowsRecoveryModels.cs"/>
    <Compile Include="$(TakupokeRepositoryRoot)/src/Takupoke.Win/Platform/WindowsLanguageRecoveryProvider.cs" Link="WindowsLanguageRecoveryProvider.cs"/>
    <Compile Include="$(TakupokeRepositoryRoot)/src/Takupoke.Win/Platform/FoundryPinnedModelStore.cs" Link="FoundryPinnedModelStore.cs"/>
    <Compile Include="$(TakupokeRepositoryRoot)/src/Takupoke.Win/Platform/FoundryLocalRecoveryProvider.cs" Link="FoundryLocalRecoveryProvider.cs"/>
    <Content Include="$(TakupokeRepositoryRoot)/src/Takupoke.Win/Assets/Recovery/*.json" Link="Assets/Recovery/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
    <None Include="$(TakupokeRepositoryRoot)/tools/raster-acquisition-native-probe/fixtures/**/*" Exclude="$(TakupokeRepositoryRoot)/tools/raster-acquisition-native-probe/fixtures/**/*.py" Link="fixtures/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
    <None Update="holdout/**/*" CopyToOutputDirectory="PreserveNewest"/>
    <None Update="recipe.json" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
